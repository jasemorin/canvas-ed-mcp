{
  "mcpServers": {
    "canvas-ed-mcp": {
      "command": "python",
      "args": [
        "/your/full/path/to/canvas_ed_mcp.py"
      ],
      "env": {
        "CANVAS_API_TOKEN": "your_canvas_api_token_here",
        "CANVAS_BASE_URL": "optional_defaults_to_https://canvas.sydney.edu.au/api/v1",
        "ED_API_TOKEN": "your_ed_api_token_here",
        "GRADESCOPE_EMAIL": "optional_gradescope_email",
        "GRADESCOPE_PASSWORD": "optional_gradescope_password"
      }
    }
  }
}
